%Root finding function via bisection algorithm
%INPUTS:
%   fun: the function we are computing the root of
%   x_left: left guess
%   x_right: right guess
%   note that f(x_left) and f(x_right) should have different signs
%   dxtol: termination threshold (stop when interval x_right-x_left < dxtol)
%   ftol: termination threshold (stop when abs(f(x_guess))<ftol
%   max_iter: maximum iteration limit
%OUTPUTS
%   x: estimate for root of fun
%   exit_flag: an integer indicating whether or not the solver succeeded
function [x, exit_flag] = bisection_solver(fun,x_left,x_right,dxtol,ftol,max_iter)

    f_left = fun(x_left);
    f_right = fun(x_right);

    % Failure: invalid interval or no bracket around a root.
    if x_left >= x_right || sign(f_left) == sign(f_right)
        x = NaN;
        exit_flag = 0;
        return
    end

    for i = 1:max_iter
        x = (x_left + x_right)/2;
        f_mid = fun(x);

        % Success.
        if abs(f_mid) < ftol || (x_right - x_left) < dxtol
            exit_flag = 1;
            return
        end

        % Preserve the half containing the sign change.
        if sign(f_left) == sign(f_mid)
            x_left = x;
            f_left = f_mid;
        else
            x_right = x;
        end
    end

    % Failure: exceeded iteration limit.
    exit_flag = 0;
end